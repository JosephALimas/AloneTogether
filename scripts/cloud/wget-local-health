#!/bin/sh
# BusyBox wget ignores NO_PROXY. Bypass the proxy only for Auth's exact
# loopback healthcheck; preserve the original behavior for every other call.
if [ "$#" -eq 4 ] && [ "$1" = "--no-verbose" ] &&
   [ "$2" = "--tries=1" ] && [ "$3" = "--spider" ] &&
   [ "$4" = "http://127.0.0.1:9999/health" ]; then
  exec /usr/bin/wget -Y off "$@"
fi
exec /usr/bin/wget "$@"
